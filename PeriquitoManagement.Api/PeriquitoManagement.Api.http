@PeriquitoManagement.Api_HostAddress = http://localhost:5169

GET {{PeriquitoManagement.Api_HostAddress}}/api/health
Accept: application/json

###

GET {{PeriquitoManagement.Api_HostAddress}}/api/categories
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

GET {{PeriquitoManagement.Api_HostAddress}}/api/categories/1
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{PeriquitoManagement.Api_HostAddress}}/api/categories
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "name": "Bebidas",
  "isActive": true
}

###

PUT {{PeriquitoManagement.Api_HostAddress}}/api/categories/1
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "name": "Bebidas frías",
  "isActive": true
}

###

DELETE {{PeriquitoManagement.Api_HostAddress}}/api/categories/1
Authorization: Bearer {{AccessToken}}

###

POST {{PeriquitoManagement.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "{{AdminUsername}}",
  "password": "{{AdminPassword}}"
}

###

GET {{PeriquitoManagement.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

GET {{PeriquitoManagement.Api_HostAddress}}/api/users
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{PeriquitoManagement.Api_HostAddress}}/api/users
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "username": "{{NewUsername}}",
  "fullName": "Usuario de prueba",
  "password": "{{NewUserPassword}}",
  "role": "Mesero"
}

###

PUT {{PeriquitoManagement.Api_HostAddress}}/api/users/{{UserId}}
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "fullName": "Usuario actualizado",
  "role": "Mesero",
  "isActive": true,
  "password": null
}

###

DELETE {{PeriquitoManagement.Api_HostAddress}}/api/users/{{UserId}}
Authorization: Bearer {{AccessToken}}

