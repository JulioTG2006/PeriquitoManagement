{
  "name": "Insumo actualizado",
  "unitOfMeasure": "kg",
  "minimumStock": 5,
  "isActive": true
}

###

DELETE {{PeriquitoManagement.Api_HostAddress}}/api/ingredients/{{IngredientId}}
Authorization: Bearer {{AccessToken}}

###

