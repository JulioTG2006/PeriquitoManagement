  "quantity": 25,
  "reason": "Compra de reposición"
}

###

POST {{PeriquitoManagement.Api_HostAddress}}/api/inventory/ingredients/{{IngredientId}}/exits
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "quantity": 10,
  "reason": "Uso manual en cocina"
}

###

GET {{PeriquitoManagement.Api_HostAddress}}/api/inventory/movements?ingredientId={{IngredientId}}&movementType=Entrada&fromUtc={{FromUtc}}&toUtc={{ToUtc}}
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

GET {{PeriquitoManagement.Api_HostAddress}}/api/inventory/movements?movementType=Salida
